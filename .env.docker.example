# Copie para .env.docker. As portas sao publicadas somente em 127.0.0.1.
POSTGRES_DB=controle_bancario
POSTGRES_USER=controle_bancario
# Fonte para .\scripts\provision_compose_secrets.ps1; o Compose nao passa este
# valor ao container operacional.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_PORT=5202
APP_PORT=5201

# Fonte para .\scripts\provision_compose_secrets.ps1. Gere um valor aleatorio
# com pelo menos 32 caracteres, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Opcional. O padrao e False; ligue apenas em maquina de desenvolvimento.
# DEBUG=False
