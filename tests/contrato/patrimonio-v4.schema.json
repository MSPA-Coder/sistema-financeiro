{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MSPA-Coder/manutencao/blob/main/docs/contratos/patrimonio-v4.schema.json",
  "title": "Contrato patrimonio/v4",
  "description": "O que o Controle Bancario (CB) e o Controle de Renda Variavel (CRV) publicam em /patrimonio/v4/{metadata,snapshot,changes} para o Wealthfolio. Copia canonica em manutencao/docs/contratos/; as copias nos repositorios dos publicadores e do consumidor sao identicas. Para mudar o contrato, mude esta e copie para todos na mesma mudanca.\n\nO que o schema exige: os campos que os publicadores emitem hoje, com o tipo e o formato de hoje (valor monetario e quantidade como texto decimal, data e instante ISO 8601, moeda ISO 4217, ids prefixados pela fonte). Remover ou renomear um campo, ou trocar o tipo dele, reprova a suite de quem fez a mudanca. O que o schema permite: propriedades a mais. Acrescimo opcional nao muda a versao do contrato (assim entraram `purpose`, `group` e `effective_status`), e quem nao o conhece o ignora. Para tornar um campo novo obrigatorio, acrescente-o a `required` aqui.\n\nUso: validar contra `#/$defs/<nome>` (cb_metadata, cb_snapshot, cb_changes, crv_metadata, crv_snapshot, crv_changes). Os formatos sao `pattern`, nao `format`: nenhum validador precisa de FormatChecker.",
  "type": "object",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Valor monetario, quantidade ou preco como texto decimal exato. Nunca numero JSON: float nao representa 0,10."
    },
    "decimal_ou_nulo": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
    "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "data_ou_nula": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] },
    "instante": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instante_ou_nulo": { "anyOf": [{ "$ref": "#/$defs/instante" }, { "type": "null" }] },
    "moeda": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "texto": { "type": "string", "minLength": 1 },
    "texto_ou_nulo": { "anyOf": [{ "$ref": "#/$defs/texto" }, { "type": "null" }] },
    "inteiro_nao_negativo": { "type": "integer", "minimum": 0 },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "description": "Opaco e assinado pela fonte. O consumidor so o repete, nunca o interpreta."
    },
    "cursor_ou_nulo": {
      "anyOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }],
      "description": "Nulo so numa fonte sem outbox transacional (capabilities.changes falso). As duas fontes de hoje tem outbox."
    },
    "id_cb": { "type": "string", "pattern": "^controle-bancario:.+$" },
    "id_cb_ou_nulo": { "anyOf": [{ "$ref": "#/$defs/id_cb" }, { "type": "null" }] },
    "id_crv": { "type": "string", "pattern": "^controle-renda-variavel:.+$" },

    "mudanca": {
      "type": "object",
      "required": ["cursor", "resource", "source_id", "operation", "changed_at"],
      "properties": {
        "cursor": { "$ref": "#/$defs/cursor" },
        "resource": { "$ref": "#/$defs/texto" },
        "source_id": { "$ref": "#/$defs/texto" },
        "operation": { "enum": ["upsert", "delete"] },
        "changed_at": { "$ref": "#/$defs/instante" },
        "payload": {
          "anyOf": [
            { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "snapshot_required" } } },
            { "type": "null" }
          ],
          "description": "Upsert manda buscar um novo snapshot. Delete e tombstone: payload omitido ou nulo."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "upsert" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "type": "object" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "delete" } } },
          "then": { "properties": { "payload": { "type": "null" } } }
        }
      ]
    },
    "changes": {
      "type": "object",
      "required": ["contrato", "recurso", "sistema", "mode", "high_watermark", "next_cursor", "has_more", "items"],
      "properties": {
        "contrato": { "const": "patrimonio/v4" },
        "recurso": { "const": "changes" },
        "sistema": { "$ref": "#/$defs/texto" },
        "mode": { "const": "snapshot_invalidation" },
        "high_watermark": { "$ref": "#/$defs/cursor" },
        "next_cursor": { "$ref": "#/$defs/cursor" },
        "has_more": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/mudanca" } }
      }
    },

    "cb_changes": {
      "allOf": [{ "$ref": "#/$defs/changes" }, { "properties": { "sistema": { "const": "controle-bancario" } } }]
    },

    "cb_conta": {
      "type": "object",
      "required": [
        "source_id", "name", "account_type", "purpose", "currency", "owner", "owner_name", "institution",
        "institution_name", "institution_type", "initial_balance", "initial_balance_date", "balance",
        "balance_as_of", "deep_link"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id_cb" },
        "name": { "$ref": "#/$defs/texto" },
        "account_type": { "enum": ["conta", "cartao_credito", "aplicacao"] },
        "purpose": { "enum": ["pessoal", "administrada"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "owner": { "$ref": "#/$defs/texto" },
        "owner_name": { "$ref": "#/$defs/texto" },
        "institution": { "$ref": "#/$defs/texto" },
        "institution_name": { "$ref": "#/$defs/texto" },
        "institution_type": { "enum": ["Banco", "Corretora"] },
        "initial_balance": { "$ref": "#/$defs/decimal" },
        "initial_balance_date": { "$ref": "#/$defs/data" },
        "balance": { "$ref": "#/$defs/decimal_ou_nulo", "description": "Nulo quando a conta ainda nao existe na data da foto: nunca zero inventado." },
        "balance_as_of": { "$ref": "#/$defs/data_ou_nula" },
        "deep_link": { "type": "string", "pattern": "^/" }
      }
    },
    "cb_categoria": {
      "type": "object",
      "required": ["source_id", "name", "kind", "group", "created_at", "updated_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id_cb" },
        "name": { "$ref": "#/$defs/texto" },
        "kind": { "enum": ["gerencial", "transferencia", "movimentacao"] },
        "group": { "$ref": "#/$defs/texto_ou_nulo" },
        "created_at": { "$ref": "#/$defs/instante_ou_nulo" },
        "updated_at": { "$ref": "#/$defs/instante_ou_nulo" }
      }
    },
    "cb_lancamento": {
      "type": "object",
      "required": [
        "source_id", "account_id", "category_id", "transfer_id", "description", "entry_type", "status",
        "effective_status", "category_kind", "currency", "planned_amount", "realized_amount", "due_date",
        "realized_date", "operation_type", "installment", "installments", "is_recurring", "created_at", "updated_at"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id_cb" },
        "account_id": { "$ref": "#/$defs/id_cb" },
        "category_id": { "$ref": "#/$defs/id_cb" },
        "transfer_id": { "$ref": "#/$defs/id_cb_ou_nulo" },
        "description": { "type": "string" },
        "entry_type": { "enum": ["receita", "despesa"] },
        "status": { "enum": ["realizado", "a_vencer", "vencidos"] },
        "effective_status": {
          "enum": ["realizado", "a_vencer", "vencidos"],
          "description": "O status que vale em snapshot_as_of, derivado da data. Muda com o dia sem que o lancamento mude."
        },
        "category_kind": { "enum": ["gerencial", "transferencia", "movimentacao"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "planned_amount": { "$ref": "#/$defs/decimal" },
        "realized_amount": { "$ref": "#/$defs/decimal_ou_nulo" },
        "due_date": { "$ref": "#/$defs/data" },
        "realized_date": { "$ref": "#/$defs/data_ou_nula" },
        "operation_type": { "$ref": "#/$defs/texto" },
        "installment": { "type": ["integer", "null"] },
        "installments": { "type": ["integer", "null"] },
        "is_recurring": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/instante_ou_nulo" },
        "updated_at": { "$ref": "#/$defs/instante_ou_nulo" }
      }
    },
    "cb_transferencia": {
      "type": "object",
      "required": ["source_id", "operation_type", "status", "legs"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id_cb" },
        "operation_type": { "$ref": "#/$defs/texto" },
        "status": { "$ref": "#/$defs/texto" },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cash_entry_id", "account_id", "entry_type", "currency", "planned_amount", "realized_amount"],
            "properties": {
              "cash_entry_id": { "$ref": "#/$defs/id_cb" },
              "account_id": { "$ref": "#/$defs/id_cb" },
              "entry_type": { "enum": ["receita", "despesa"] },
              "currency": { "$ref": "#/$defs/moeda" },
              "planned_amount": { "$ref": "#/$defs/decimal" },
              "realized_amount": { "$ref": "#/$defs/decimal_ou_nulo" }
            }
          }
        }
      }
    },
    "cb_item": {
      "type": "object",
      "required": ["resource", "source_id", "payload"],
      "properties": {
        "resource": { "enum": ["account", "category", "cash_entry", "transfer"] },
        "source_id": { "$ref": "#/$defs/id_cb" },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "resource": { "const": "account" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/cb_conta" } } }
        },
        {
          "if": { "properties": { "resource": { "const": "category" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/cb_categoria" } } }
        },
        {
          "if": { "properties": { "resource": { "const": "cash_entry" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/cb_lancamento" } } }
        },
        {
          "if": { "properties": { "resource": { "const": "transfer" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/cb_transferencia" } } }
        }
      ]
    },
    "cb_capabilities": {
      "type": "object",
      "required": ["snapshot", "changes", "resources", "decimal_strings", "read_only"],
      "properties": {
        "snapshot": { "type": "boolean" },
        "changes": { "type": "boolean" },
        "resources": {
          "type": "object",
          "required": ["account", "cash_entry", "category", "transfer"],
          "additionalProperties": { "type": "boolean" }
        },
        "decimal_strings": { "const": true },
        "read_only": { "const": true }
      }
    },
    "cb_coverage": {
      "type": "object",
      "required": ["account", "cash_entry", "category", "transfer", "incremental_changes"],
      "properties": {
        "account": {
          "type": "object",
          "required": ["state", "count"],
          "properties": { "state": { "enum": ["complete", "partial"] }, "count": { "$ref": "#/$defs/inteiro_nao_negativo" } }
        },
        "cash_entry": {
          "type": "object",
          "required": ["state", "count", "due_date_from", "due_date_through", "statuses"],
          "properties": {
            "state": { "enum": ["complete", "partial"] },
            "count": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "due_date_from": { "$ref": "#/$defs/data_ou_nula" },
            "due_date_through": { "$ref": "#/$defs/data_ou_nula" },
            "statuses": { "type": "array", "items": { "enum": ["realizado", "a_vencer", "vencidos"] } }
          }
        },
        "category": {
          "type": "object",
          "required": ["state", "count"],
          "properties": { "state": { "enum": ["complete", "partial"] }, "count": { "$ref": "#/$defs/inteiro_nao_negativo" } }
        },
        "transfer": {
          "type": "object",
          "required": ["state", "unlinked_cash_entries", "incomplete_groups"],
          "properties": {
            "state": { "enum": ["complete", "partial"] },
            "unlinked_cash_entries": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "incomplete_groups": { "$ref": "#/$defs/inteiro_nao_negativo" }
          }
        },
        "incremental_changes": {
          "type": "object",
          "required": ["state", "endpoint", "mode", "high_watermark"],
          "properties": {
            "state": { "enum": ["available", "unavailable"] },
            "endpoint": { "$ref": "#/$defs/texto" },
            "mode": { "const": "snapshot_invalidation" },
            "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" }
          }
        }
      }
    },
    "cb_metadata": {
      "type": "object",
      "required": ["contrato", "sistema", "generated_at", "high_watermark", "capabilities", "coverage", "snapshot_as_of"],
      "properties": {
        "contrato": { "const": "patrimonio/v4" },
        "sistema": { "const": "controle-bancario" },
        "generated_at": { "$ref": "#/$defs/instante" },
        "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" },
        "capabilities": { "$ref": "#/$defs/cb_capabilities" },
        "coverage": { "$ref": "#/$defs/cb_coverage" },
        "snapshot_as_of": { "$ref": "#/$defs/data" }
      }
    },
    "cb_snapshot": {
      "type": "object",
      "required": [
        "contrato", "sistema", "generated_at", "snapshot_id", "high_watermark", "capabilities", "coverage",
        "snapshot_as_of", "items"
      ],
      "properties": {
        "contrato": { "const": "patrimonio/v4" },
        "sistema": { "const": "controle-bancario" },
        "generated_at": { "$ref": "#/$defs/instante" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" },
        "capabilities": { "$ref": "#/$defs/cb_capabilities" },
        "coverage": { "$ref": "#/$defs/cb_coverage" },
        "snapshot_as_of": { "$ref": "#/$defs/data" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/cb_item" } }
      }
    },

    "crv_changes": {
      "allOf": [{ "$ref": "#/$defs/changes" }, { "properties": { "sistema": { "const": "controle-renda-variavel" } } }]
    },
    "crv_capacidades": {
      "type": "object",
      "required": ["holdings", "position_ledger", "income", "activities", "prices", "options", "complete_trades", "changes"],
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "holdings": { "type": "boolean" },
        "position_ledger": { "type": "boolean" },
        "income": { "type": "boolean" },
        "activities": { "type": "boolean" },
        "prices": { "type": "boolean" },
        "options": { "type": "boolean" },
        "complete_trades": { "type": "boolean" },
        "changes": { "type": "boolean" }
      }
    },
    "crv_conta": {
      "type": "object",
      "required": ["id", "source_id", "snapshot_id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/texto" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "name": { "$ref": "#/$defs/texto" },
        "type": { "const": "brokerage" }
      }
    },
    "crv_holding": {
      "type": "object",
      "required": [
        "id", "source_id", "snapshot_id", "titular", "account", "account_name", "portfolio", "instrument",
        "instrument_type", "market", "currency", "side", "quantity", "average_cost", "current_price",
        "market_value", "price_kind", "valuation_method", "price_observed_at", "price_status", "deep_link"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id_crv" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "titular": { "$ref": "#/$defs/texto" },
        "account": { "$ref": "#/$defs/texto" },
        "account_name": { "$ref": "#/$defs/texto" },
        "portfolio": { "$ref": "#/$defs/texto" },
        "instrument": { "$ref": "#/$defs/texto" },
        "instrument_type": {
          "const": "equity",
          "description": "No piloto o unico valor aceito. O consumidor rejeita qualquer outro: uma expansao de cobertura exige contrato e mapeamento explicitos."
        },
        "market": { "enum": ["B3", "NYSE", "NASDAQ"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "side": { "enum": ["long", "short"] },
        "quantity": { "$ref": "#/$defs/decimal", "description": "Com sinal: negativa na posicao vendida." },
        "average_cost": { "$ref": "#/$defs/decimal" },
        "current_price": { "$ref": "#/$defs/decimal_ou_nulo", "description": "Nulo sem cotacao: nunca preco inventado." },
        "market_value": { "$ref": "#/$defs/decimal_ou_nulo", "description": "Negativo na posicao vendida. Nulo sem cotacao." },
        "price_kind": {
          "enum": ["unavailable", "side_specific_buy_quote", "side_specific_sell_quote", "last_price_fallback"]
        },
        "valuation_method": { "$ref": "#/$defs/texto" },
        "price_observed_at": { "$ref": "#/$defs/instante_ou_nulo" },
        "price_status": { "$ref": "#/$defs/texto_ou_nulo" },
        "deep_link": { "type": "string", "pattern": "^/" }
      }
    },
    "crv_renda": {
      "type": "object",
      "required": [
        "id", "source_id", "snapshot_id", "date", "instrument", "kind", "currency", "amount", "role",
        "cash_accounting_role", "duplicate_risk", "account", "account_name", "titular", "deep_link"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id_crv" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "date": { "$ref": "#/$defs/data" },
        "instrument": { "$ref": "#/$defs/texto" },
        "kind": { "enum": ["dividendo", "jcp", "aluguel"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "amount": { "$ref": "#/$defs/decimal" },
        "role": { "const": "analytic_only" },
        "cash_accounting_role": { "const": "not_a_cash_entry" },
        "duplicate_risk": { "$ref": "#/$defs/texto" },
        "account": { "$ref": "#/$defs/texto" },
        "account_name": { "$ref": "#/$defs/texto" },
        "titular": { "$ref": "#/$defs/texto" },
        "deep_link": { "type": "string", "pattern": "^/" }
      }
    },
    "crv_preco_atual": {
      "type": "object",
      "required": [
        "id", "source_id", "snapshot_id", "instrument", "market", "currency", "price", "observed_at", "status",
        "price_kind", "valuation_method"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id_crv" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "instrument": { "$ref": "#/$defs/texto" },
        "market": { "enum": ["B3", "NYSE", "NASDAQ"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "price": { "$ref": "#/$defs/decimal" },
        "observed_at": { "$ref": "#/$defs/instante" },
        "status": { "$ref": "#/$defs/texto" },
        "price_kind": { "const": "collector_last_price" },
        "valuation_method": { "const": "not_used_for_position_valuation" }
      }
    },
    "crv_preco_historico": {
      "type": "object",
      "required": [
        "id", "source_id", "snapshot_id", "instrument", "market", "currency", "price", "date", "observed_at",
        "price_kind", "valuation_method"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id_crv" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "instrument": { "$ref": "#/$defs/texto" },
        "market": { "enum": ["B3", "NYSE", "NASDAQ"] },
        "currency": { "$ref": "#/$defs/moeda" },
        "price": { "$ref": "#/$defs/decimal" },
        "date": { "$ref": "#/$defs/data" },
        "observed_at": { "$ref": "#/$defs/instante" },
        "price_kind": { "const": "daily_last_observation" },
        "valuation_method": { "const": "not_used_for_position_valuation" }
      }
    },
    "crv_coverage_snapshot": {
      "type": "object",
      "required": ["holdings", "income", "prices", "options", "exclusions", "changes"],
      "properties": {
        "holdings": {
          "type": "object",
          "required": ["included", "unpriced", "complete", "scope"],
          "properties": {
            "included": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "unpriced": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "complete": { "type": "boolean" },
            "scope": { "$ref": "#/$defs/texto" }
          }
        },
        "income": {
          "type": "object",
          "required": ["included", "do_not_rebook_as_cash"],
          "properties": {
            "included": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "do_not_rebook_as_cash": { "const": true }
          }
        },
        "prices": {
          "type": "object",
          "required": ["current_included", "history_included", "complete", "omitted"],
          "properties": {
            "current_included": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "history_included": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "complete": { "type": "boolean" },
            "omitted": { "enum": ["consumer_requested", null] }
          }
        },
        "options": {
          "type": "object",
          "required": ["available", "excluded_options", "excluded_simulated"],
          "properties": {
            "available": { "const": false },
            "excluded_options": { "$ref": "#/$defs/inteiro_nao_negativo" },
            "excluded_simulated": { "$ref": "#/$defs/inteiro_nao_negativo" }
          }
        },
        "exclusions": {
          "type": "object",
          "required": ["unpriced_holdings", "excluded_simulated", "excluded_options"],
          "additionalProperties": { "$ref": "#/$defs/inteiro_nao_negativo" }
        },
        "changes": {
          "type": "object",
          "required": ["available", "endpoint", "mode", "high_watermark"],
          "properties": {
            "available": { "type": "boolean" },
            "endpoint": { "$ref": "#/$defs/texto" },
            "mode": { "const": "snapshot_invalidation" },
            "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" }
          }
        }
      }
    },
    "crv_snapshot": {
      "type": "object",
      "required": [
        "contrato", "recurso", "sistema", "source_id", "snapshot_id", "generated_at", "gerado_em",
        "data_de_referencia", "high_watermark", "capacidades", "coverage", "accounts", "holdings", "income", "prices"
      ],
      "properties": {
        "contrato": { "const": "patrimonio/v4" },
        "recurso": { "const": "snapshot" },
        "sistema": { "const": "controle-renda-variavel" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "snapshot_id": { "$ref": "#/$defs/texto" },
        "generated_at": { "$ref": "#/$defs/instante" },
        "gerado_em": { "$ref": "#/$defs/instante" },
        "data_de_referencia": { "$ref": "#/$defs/data" },
        "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" },
        "capacidades": { "$ref": "#/$defs/crv_capacidades" },
        "coverage": { "$ref": "#/$defs/crv_coverage_snapshot" },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/crv_conta" } },
        "holdings": { "type": "array", "items": { "$ref": "#/$defs/crv_holding" } },
        "income": { "type": "array", "items": { "$ref": "#/$defs/crv_renda" } },
        "prices": {
          "type": "object",
          "required": ["current", "history"],
          "properties": {
            "current": { "type": "array", "items": { "$ref": "#/$defs/crv_preco_atual" } },
            "history": { "type": "array", "items": { "$ref": "#/$defs/crv_preco_historico" } }
          }
        }
      }
    },
    "crv_metadata": {
      "type": "object",
      "required": ["contrato", "recurso", "sistema", "source_id", "gerado_em", "high_watermark", "capacidades", "coverage"],
      "properties": {
        "contrato": { "const": "patrimonio/v4" },
        "recurso": { "const": "metadata" },
        "sistema": { "const": "controle-renda-variavel" },
        "source_id": { "$ref": "#/$defs/id_crv" },
        "gerado_em": { "$ref": "#/$defs/instante" },
        "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" },
        "capacidades": { "$ref": "#/$defs/crv_capacidades" },
        "coverage": {
          "type": "object",
          "required": ["holdings", "income", "prices", "options", "changes"],
          "properties": {
            "holdings": {
              "type": "object",
              "required": ["available", "includes_unpriced"],
              "properties": { "available": { "type": "boolean" }, "includes_unpriced": { "type": "boolean" } }
            },
            "income": {
              "type": "object",
              "required": ["available", "do_not_rebook_as_cash"],
              "properties": { "available": { "type": "boolean" }, "do_not_rebook_as_cash": { "const": true } }
            },
            "prices": {
              "type": "object",
              "required": ["available", "history_days_limit", "history_window_guaranteed"],
              "properties": {
                "available": { "type": "boolean" },
                "history_days_limit": { "type": "integer", "minimum": 1 },
                "history_window_guaranteed": { "const": false }
              }
            },
            "options": {
              "type": "object",
              "required": ["available"],
              "properties": { "available": { "const": false } }
            },
            "changes": {
              "type": "object",
              "required": ["available", "endpoint", "mode", "high_watermark"],
              "properties": {
                "available": { "type": "boolean" },
                "endpoint": { "$ref": "#/$defs/texto" },
                "mode": { "const": "snapshot_invalidation" },
                "high_watermark": { "$ref": "#/$defs/cursor_ou_nulo" }
              }
            }
          }
        }
      }
    }
  }
}
