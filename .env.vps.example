# Arquivo de ambiente do VPS. Copie para .env.vps; nao inclua segredos aqui.
POSTGRES_DB=controle_bancario
POSTGRES_USER=controle_bancario
POSTGRES_PORT=5202
APP_PORT=5201
DEBUG=False
USE_HTTPS=True
ALLOWED_HOSTS=bancario-mspa.duckdns.org,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bancario-mspa.duckdns.org
# Atras do nginx, a conexao chega do gateway da rede do Docker; sem isto a
# auditoria e a trava de login gravam esse gateway em vez do cliente.
AUDIT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
